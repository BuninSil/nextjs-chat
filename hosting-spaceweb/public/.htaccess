Options -Indexes
DirectoryIndex index.html index.php

<IfModule mod_rewrite.c>
RewriteEngine On
# The temporary SpaceWeb technical host has no SSL on this plan.
# Keep HTTPS enforcement for the real production domain only.
RewriteCond %{HTTP_HOST} ^(www\.)?buninsil-fast-vpn\.ru$ [NC]
RewriteCond %{HTTPS} !=on
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]
</IfModule>

<FilesMatch "(^\.|\.sql$|\.log$|\.ini$|\.bak$|\.env$|config\.php$|private-loader\.php$|\.new$|\.previous$|\.tmp$)">
  Require all denied
</FilesMatch>

<IfModule mod_headers.c>
Header always set X-Content-Type-Options "nosniff"
Header always set Referrer-Policy "strict-origin-when-cross-origin"
Header always set X-Frame-Options "DENY"
</IfModule>

AddType application/vnd.android.package-archive .apk
<Files "fast-vpn.apk">
  <IfModule mod_headers.c>
    Header set Cache-Control "no-store"
    Header set Content-Disposition "attachment; filename=fast-vpn.apk"
  </IfModule>
</Files>
