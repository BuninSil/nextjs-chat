<resources>
    <!-- Тёмная тема с зелёным акцентом — как на главном экране -->
    <style name="AppTheme" parent="Theme.AppCompat.NoActionBar">
        <item name="colorPrimary">#121417</item>
        <item name="colorPrimaryDark">#121417</item>
        <item name="colorAccent">#34C759</item>
        <item name="android:windowBackground">#121417</item>
        <item name="android:statusBarColor">#121417</item>
        <item name="android:navigationBarColor">#121417</item>
        <item name="android:textColorPrimary">#E8EAED</item>
        <item name="android:textColorSecondary">#8B9098</item>
        <item name="alertDialogTheme">@style/AppDialog</item>
        <item name="android:alertDialogTheme">@style/AppDialogFramework</item>
    </style>

    <style name="AppDialog" parent="Theme.AppCompat.Dialog.Alert">
        <item name="colorAccent">#34C759</item>
        <item name="android:windowBackground">@drawable/dialog_bg</item>
        <item name="android:textColorPrimary">#E8EAED</item>
    </style>

    <!-- Для android.app.AlertDialog: тот же вид на базе системной темы -->
    <style name="AppDialogFramework" parent="android:Theme.Material.Dialog.Alert">
        <item name="android:colorAccent">#34C759</item>
        <item name="android:windowBackground">@drawable/dialog_bg</item>
        <item name="android:textColorPrimary">#E8EAED</item>
    </style>

    <!-- Светлая тема: системные окна (AlertDialog) светлые -->
    <style name="AppTheme.Light" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="colorPrimary">#F3F5F7</item>
        <item name="colorPrimaryDark">#F3F5F7</item>
        <item name="colorAccent">#1FA34A</item>
        <item name="android:windowBackground">#F3F5F7</item>
        <item name="android:textColorPrimary">#15181C</item>
        <item name="android:textColorSecondary">#6B7280</item>
        <item name="alertDialogTheme">@style/AppDialog.Light</item>
        <item name="android:alertDialogTheme">@style/AppDialogFramework.Light</item>
    </style>

    <style name="AppDialog.Light" parent="Theme.AppCompat.Light.Dialog.Alert">
        <item name="colorAccent">#1FA34A</item>
        <item name="android:windowBackground">@drawable/dialog_bg_light</item>
        <item name="android:textColorPrimary">#15181C</item>
    </style>

    <style name="AppDialogFramework.Light" parent="android:Theme.Material.Light.Dialog.Alert">
        <item name="android:colorAccent">#1FA34A</item>
        <item name="android:windowBackground">@drawable/dialog_bg_light</item>
        <item name="android:textColorPrimary">#15181C</item>
    </style>
</resources>
