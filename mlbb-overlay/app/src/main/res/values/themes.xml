<resources>
    <!-- Новый тёмный интерфейс -->
    <style name="AppTheme" parent="Theme.AppCompat.NoActionBar">
        <item name="colorPrimary">#0D0F13</item>
        <item name="colorPrimaryDark">#0D0F13</item>
        <item name="colorAccent">#1ED760</item>
        <item name="android:colorAccent">#1ED760</item>
        <item name="android:windowBackground">#0D0F13</item>
        <item name="android:statusBarColor">#0D0F13</item>
        <item name="android:navigationBarColor">#0D0F13</item>
        <item name="android:textColorPrimary">#EBEBEF</item>
        <item name="android:textColorSecondary">#8A9099</item>
        <item name="alertDialogTheme">@style/AppDialog</item>
        <item name="android:alertDialogTheme">@style/AppDialogFramework</item>
    </style>
    <style name="AppDialog" parent="Theme.AppCompat.Dialog.Alert">
        <item name="colorAccent">#1ED760</item>
        <item name="android:colorAccent">#1ED760</item>
        <item name="android:windowBackground">@drawable/dialog_bg</item>
        <item name="android:textColorPrimary">#EBEBEF</item>
        <item name="android:textColorSecondary">#8A9099</item>
    </style>
    <style name="AppDialogFramework" parent="android:Theme.Material.Dialog.Alert">
        <item name="android:colorAccent">#1ED760</item>
        <item name="android:windowBackground">@drawable/dialog_bg</item>
        <item name="android:textColorPrimary">#EBEBEF</item>
        <item name="android:textColorSecondary">#8A9099</item>
    </style>

    <!-- Классическая тёмная тема -->
    <style name="AppTheme.DarkClassic" parent="Theme.AppCompat.NoActionBar">
        <item name="colorPrimary">#121417</item>
        <item name="colorPrimaryDark">#121417</item>
        <item name="colorAccent">#34C759</item>
        <item name="android:colorAccent">#34C759</item>
        <item name="android:windowBackground">#121417</item>
        <item name="android:statusBarColor">#121417</item>
        <item name="android:navigationBarColor">#121417</item>
        <item name="android:textColorPrimary">#E8EAED</item>
        <item name="android:textColorSecondary">#8B9098</item>
        <item name="alertDialogTheme">@style/AppDialog.DarkClassic</item>
        <item name="android:alertDialogTheme">@style/AppDialogFramework.DarkClassic</item>
    </style>
    <style name="AppDialog.DarkClassic" parent="Theme.AppCompat.Dialog.Alert">
        <item name="colorAccent">#34C759</item>
        <item name="android:colorAccent">#34C759</item>
        <item name="android:windowBackground">@drawable/dialog_bg_dark_classic</item>
        <item name="android:textColorPrimary">#E8EAED</item>
        <item name="android:textColorSecondary">#8B9098</item>
    </style>
    <style name="AppDialogFramework.DarkClassic" parent="android:Theme.Material.Dialog.Alert">
        <item name="android:colorAccent">#34C759</item>
        <item name="android:windowBackground">@drawable/dialog_bg_dark_classic</item>
        <item name="android:textColorPrimary">#E8EAED</item>
        <item name="android:textColorSecondary">#8B9098</item>
    </style>

    <!-- Неоновая тема: холодный циан и фиолетовые поверхности -->
    <style name="AppTheme.Neon" parent="Theme.AppCompat.NoActionBar">
        <item name="colorPrimary">#07070F</item>
        <item name="colorPrimaryDark">#07070F</item>
        <item name="colorAccent">#00E5FF</item>
        <item name="android:colorAccent">#00E5FF</item>
        <item name="android:windowBackground">#07070F</item>
        <item name="android:statusBarColor">#07070F</item>
        <item name="android:navigationBarColor">#07070F</item>
        <item name="android:textColorPrimary">#EAF6FF</item>
