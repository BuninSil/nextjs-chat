        <item name="android:alertDialogTheme">@style/AppDialogFramework.Light</item>
    </style>
    <style name="AppDialog.Light" parent="Theme.AppCompat.Light.Dialog.Alert">
        <item name="colorAccent">#1FA34A</item>
        <item name="android:colorAccent">#1FA34A</item>
        <item name="android:windowBackground">@drawable/dialog_bg_light</item>
        <item name="android:textColorPrimary">#15181C</item>
        <item name="android:textColorSecondary">#6B7280</item>
